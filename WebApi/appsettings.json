{
  "Endpoints": {
    "Https": {
      "Url": "https://localhost:5001"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "my-api",
    "Audience": "my-api-users",
    "ExpiresInMinutes": 60
  },
  "Kafka": {
    "CarEvent": {
      "Topic": "car.event",
      "BootstrapServers": "localhost:29092",
      "Acks": -1,
      "Idempotence": true
    },
    "SearchEvent": {
      "Topic": "search.event",
      "BootstrapServers": "localhost:29092",
      "Acks": -1,
      "Idempotence": true
    }
  },
  "AllowedHosts": "*",
  "Urls": "https://localhost:5001;https://+:7138;http://localhost:5026"
}
